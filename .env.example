OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
REQUEST_DELAY_SECONDS=0.75
MAX_RETRIES=8
MAX_BACKOFF_SECONDS=60
# RUN_ID=optional-readable-run-name
# Set this or dashboard/.env.local to automatically save completed runs to PostgreSQL for the dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/data_annotation
